{
  "name": "savoria",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:server": "node --test tests/server/*.test.js",
    "test:browser": "playwright test",
    "test:browser:solo": "playwright test --config=playwright.solo.config.js",
    "test": "npm run test:unit && npm run test:server"
  },
  "devDependencies": {
    "@colyseus/loadtest": "0.18.2",
    "@colyseus/testing": "0.18.5",
    "@colyseus/tools": "0.18.3",
    "@playwright/test": "1.62.1"
  },
  "dependencies": {
    "@colyseus/core": "0.18.10",
    "@colyseus/schema": "5.0.25",
    "@colyseus/sdk": "0.18.2",
    "@colyseus/ws-transport": "0.18.2",
    "express": "5.2.1"
  }
}
